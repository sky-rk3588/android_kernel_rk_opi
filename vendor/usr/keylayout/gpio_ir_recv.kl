# Keylayout file for GPIO IR receiver (gpio-ir-recv)
# Orange Pi 5 Plus iDroid remote

key 0x4cb3 POWER
key 0xccb3 HOME
key 0x2cb3 MENU
key 0xacb3 BACK

key 0x0cb3 UP
key 0x8cb3 DOWN
key 0x44b3 LEFT
key 0xc4b3 RIGHT
key 0x24b3 ENTER

key 0xa4b3 VOLUME_UP
key 0x64b3 VOLUME_DOWN
